# pitrdrill 隔离恢复配置(自动生成)
listen_addresses = '127.0.0.1'
port = 55500
unix_socket_directories = '/tmp/pitrdrill-sockets/pitrdrill-work/restore/R1-early'
hot_standby = on
restore_command = '/workspace/pitrdrill-work/restores/R1-early/pitrdrill-restore-fetch.sh %f %p'
recovery_target_name = 'rp_early'
recovery_target_action = 'pause'
recovery_target_timeline = '1'
archive_mode = off
log_line_prefix = '%m [%p] %q%u@%d '
log_min_messages = info
