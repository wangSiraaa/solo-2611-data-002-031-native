      "chapter_id": "n9",
      "title": "付款",
      "paragraphs": [
        {
          "id": "b8",
          "text": "付款前应先核对合同、验收单和发票，再完成复核。"
        },
        {
          "id": "b2",
          "text": "特殊事项由负责人确认。"
        }
      ]
    },
    {
      "chapter_id": "n2",
      "title": "采购",
      "paragraphs": [
        {
          "id": "b4",
          "text": "采购申请应附完整预算依据。审批通过后方可下单。"
        },
        {
          "id": "b7",
          "text": "供应商名称包含 Café 与组合字符 é，引用必须保留原文。"
        },
        {
          "id": "b3",
          "text": "特殊事项由负责人确认。"
        },
        {
          "id": "b5",
          "text": "新增线上材料归档要求。"
        }
      ]
    }
  ]
}
