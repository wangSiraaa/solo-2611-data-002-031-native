{
  "document_id": "policy",
  "version": "A",
  "chapters": [
    {
      "chapter_id": "c1",
      "title": "采购",
      "paragraphs": [
        {
          "id": "a1",
          "text": "采购申请应附预算依据。审批通过后方可下单。"
        },
        {
          "id": "a2",
          "text": "特殊事项由负责人确认。"
        },
        {
          "id": "a3",
          "text": "供应商名称包含 Café 与组合字符 é，引用必须保留原文。"
        }
      ]
    },
    {
      "chapter_id": "c2",
      "title": "付款",
      "paragraphs": [
        {
          "id": "a4",
          "text": "付款前应核对合同、验收单和发票。"
        },
        {
          "id": "a5",
          "text": "特殊事项由负责人确认。"
        },
        {
          "id": "a6",
          "text": "纸质材料保存三年。"
        }
      ]
    }
  ]
}
